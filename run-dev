#!/bin/bash

if [ -z "$1" ]; then
    echo "Usage: ./run-dev <lesson|ds|alg> <number>"
    exit 1
fi

COMMAND=$1

# Ensure cargo-watch exists
if ! command -v cargo-watch &> /dev/null; then
    echo "cargo-watch not found. Installing..."
    cargo install cargo-watch
fi

case "$COMMAND" in
    lesson|ds|alg)
        if [ -z "$2" ]; then
            echo "Usage: ./run-dev $COMMAND <number>"
            exit 1
        fi

        cargo watch -q -c -x "run -p ${COMMAND}_$2"
        ;;
    *)
        # Preserve support for watching a globally unique binary directly.
        cargo watch -q -c -x "run --bin $COMMAND"
        ;;
esac
