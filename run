#!/bin/bash

if [ -z "$1" ]; then
    echo "Usage:"
    echo "  ./run <lesson|ds|alg> <number>"
    echo "  ./run <bin>"
    exit 1
fi

COMMAND=$1

# Ensure cargo exists
if ! command -v cargo &> /dev/null; then
    echo "Cargo not found. Installing Rust..."
    curl https://sh.rustup.rs -sSf | sh -s -- -y
    source "$HOME/.cargo/env"
fi

case "$COMMAND" in
    lesson|ds|alg)
        if [ -z "$2" ]; then
            echo "Usage: ./run $COMMAND <number>"
            exit 1
        fi

        cargo run -p "${COMMAND}_$2"
        ;;
    *)
        # Preserve support for running a globally unique binary directly.
        cargo run --bin "$COMMAND"
        ;;
esac
